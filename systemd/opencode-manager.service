[Unit]
Description=OpenCode bridge manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/opencode-manager.env
ExecStart=/usr/bin/node --experimental-strip-types --experimental-sqlite /opt/opencode-bridge/src/manager.ts
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target

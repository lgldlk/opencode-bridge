BRIDGE_KEY=replace-with-machine-bridge-key
OPENCODE_PASSWORD=replace-with-opencode-password
OPENCODE_USERNAME=opencode
OPENCODE_URL=https://opencode.example.invalid
OPENCODE_DIRECTORY=/srv/opencode/workspace
# Optional: provider id or provider/model. Empty delegates to OpenCode's
# provider catalog default.
DEFAULT_MODEL=
OPENCODE_SERVER_PASSWORD=replace-with-opencode-password
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_REQUEST_TIMEOUT_MS=3600000
OPENCODE_FIRST_DATA_TIMEOUT_MS=900000
OPENCODE_EVENT_CONNECT_TIMEOUT_MS=15000
# Bounded MCP schema bridge pool. Reusing slots avoids stale tools and
# unbounded MCP registrations in a long-lived OpenCode process.
OPENCODE_TOOL_BRIDGE_POOL_SIZE=8
OPENCODE_TOOL_BRIDGE_ACQUIRE_TIMEOUT_MS=10000

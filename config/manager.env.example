MANAGER_CONFIG=/etc/opencode-manager.json
MANAGER_ADMIN_KEY=replace-with-a-long-random-admin-key
MANAGER_API_KEY=replace-with-a-long-random-client-key
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8090
MANAGER_REQUEST_TIMEOUT_MS=3600000
MANAGER_HEALTH_INTERVAL_MS=30000
# Optional hard overrides. Without these, use the persisted settings in /admin.
# MANAGER_ROUTING_STRATEGY=random
# MANAGER_RATE_LIMIT_COOLDOWN_MS=3600000
